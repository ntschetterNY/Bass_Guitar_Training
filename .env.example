# Copy to .env next to compose.yaml in your Dockge stack and edit.

# GHCR image to run (lowercase owner). Built and pushed by GitHub Actions.
IMAGE=ghcr.io/ntschetterny/bass_guitar_training:latest

# Port the app is reachable on from your LAN.
HOST_PORT=8090

# Host path for the SQLite database — your TrueNAS dataset (Host Path).
DATA_PATH=/mnt/tank/configs/Bass_Guitar

# UID:GID the container runs as. Must be able to write DATA_PATH.
# The Bass_Guitar dataset is root:root, so 0:0 works as-is. If you instead
# chown the dataset to 1000:1000, set PUID=1000 / PGID=1000.
PUID=0
PGID=0
